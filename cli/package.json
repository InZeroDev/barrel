{
	"name": "@inzero/barrel",
	"version": "0.0.2",
	"description": "Generate barrel files.",
	"keywords": [
		"cli",
		"barrel",
		"generate"
	],
	"license": "MIT",
	"author": "InZero",
	"files": [
		"dist",
		".dev/config.default.json",
		"package.json",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"bin": {
		"barrel": "dist/index.js"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"format": "prettier --write ."
	},
	"dependencies": {
		"env-paths": "^4.0.0",
		"fast-glob": "^3.3.3",
		"fs-extra": "^11.4.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@inzero/ts-ut": "^0.0.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^26.6.5",
		"commander": "^15.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-packagejson": "^3.0.2",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	},
	"cliName": "barrel"
}
