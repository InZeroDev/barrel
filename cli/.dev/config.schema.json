{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"presets": {
			"default": {},
			"type": "object",
			"propertyNames": { "type": "string" },
			"additionalProperties": {
				"type": "object",
				"properties": {
					"includeFiles": { "type": "array", "items": { "type": "string" } },
					"includeFolders": { "type": "array", "items": { "type": "string" } },
					"excludeFiles": { "type": "array", "items": { "type": "string" } },
					"excludeFolders": { "type": "array", "items": { "type": "string" } },
					"fileFormat": { "type": "string" },
					"folderFormat": { "type": "string" },
					"requiredIndex": { "type": "string" }
				},
				"required": ["fileFormat"]
			}
		},
		"defaults": {
			"default": {},
			"type": "object",
			"properties": {
				"includeFiles": { "default": ["*$E"], "type": "array", "items": { "type": "string" } },
				"includeFolders": { "default": ["*"], "type": "array", "items": { "type": "string" } },
				"excludeFiles": { "default": ["_*"], "type": "array", "items": { "type": "string" } },
				"excludeFolders": { "default": ["_*"], "type": "array", "items": { "type": "string" } },
				"requiredIndex": { "default": "index$E", "type": "string" }
			}
		},
		"openConfigCmd": { "default": "code $P", "type": "string" }
	}
}
