{
	"presets": {
		"js": {
			"fileFormat": "export * from './$P$E';",
			"folderFormat": "export * from './$P/index$E';"
		},
		"ts": {
			"fileFormat": "export * from './$P';"
		},
    "ts-imp": {
      "fileFormat": "import './$P';"
    },
		"css": {
			"fileFormat": "@import './$P$E';",
			"folderFormat": "@import './$P/index$E';"
		},
		"sass": {
			"fileFormat": "@forward './$P';",
			"folderFormat": "@forward './$P/index';"
		}
	},
	"defaults": {
		"fileInclude": ["*$E"],
		"folderInclude": ["*"],
		"fileExclude": ["_*"],
		"folderExclude": ["_*"],
		"requiredIndex": "index$E"
	},
	"openConfigCmd": "code $P"
}
